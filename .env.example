# ──────────────────────────────────────────────────────────────────
# LearnPath AI — Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────────

# ─── LLM Configuration ───────────────────────────────────────────
# Provider: gemini or openai
LLM_PROVIDER=gemini

# Your API key (get from https://aistudio.google.com or https://platform.openai.com)
LLM_API_KEY=your_api_key_here

# Optional: override the default model
# LLM_MODEL=gemini-1.5-flash
# LLM_MODEL=gpt-3.5-turbo

# ─── Database ─────────────────────────────────────────────────────
# SQLite (default, no setup needed)
DATABASE_URL=sqlite:///./learnpath.db

# PostgreSQL example (uncomment to use):
# DATABASE_URL=postgresql://username:password@localhost:5432/learnpath_db

# ─── Backend URL (for Streamlit frontend) ────────────────────────
BACKEND_URL=http://localhost:8000
